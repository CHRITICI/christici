{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-08-25",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Base de données D1 — la production sera créée au moment du déploiement
  // (npx wrangler d1 create christici-production) et l'ID renseigné ici.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "christici-production",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
